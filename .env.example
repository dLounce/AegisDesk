# Copy to .env and fill in. .env is ignored by git and must never be committed.

# Model providers. At least one is required to run the agents.
# Nothing in the codebase reads these yet; configuration is introduced with the
# model provider factory.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# PostgreSQL connection string for durable checkpoints, approvals, and audit.
# Leave unset to use the in-memory implementations (tests and local runs).
AEGISDESK_DATABASE_URL=
