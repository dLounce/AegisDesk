# Copy to .env and fill in. .env is ignored by git and must never be committed.

# Model providers. The default is the deterministic scripted model, which needs no key;
# set a key only to run the live provider. The live model is untrusted like the scripted one.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Live model configuration (aegisdesk.config). Leave AEGISDESK_MODEL_PROVIDER unset (or
# "scripted") for the deterministic default used by tests and local runs. Set it to
# "openai_compatible" to use one ChatOpenAI-compatible endpoint (OpenAI, OpenRouter, ...);
# base_url selects the endpoint and the API key is read from AEGISDESK_MODEL_API_KEY, or
# failing that from OPENAI_API_KEY / OPENROUTER_API_KEY above.
AEGISDESK_MODEL_PROVIDER=
AEGISDESK_MODEL_NAME=
AEGISDESK_MODEL_BASE_URL=
AEGISDESK_MODEL_API_KEY=
AEGISDESK_MODEL_TIMEOUT_SECONDS=

# Live simulated-employee (persona) model configuration (S20), kept independent of the agent model
# above. Used only by the gated live evaluation path; the default offline suite never reads it. Set
# AEGISDESK_PERSONA_MODEL_PROVIDER to "openai_compatible" to back LivePersonaEmployee with a real
# model; the key is read from AEGISDESK_PERSONA_MODEL_API_KEY, or failing that OPENAI_API_KEY /
# OPENROUTER_API_KEY (never AEGISDESK_MODEL_API_KEY). Temperature is the stochastic-sampling knob
# (nonzero default 0.9); it configures the experiment, it does not guarantee different outputs.
AEGISDESK_PERSONA_MODEL_PROVIDER=
AEGISDESK_PERSONA_MODEL_NAME=
AEGISDESK_PERSONA_MODEL_BASE_URL=
AEGISDESK_PERSONA_MODEL_API_KEY=
AEGISDESK_PERSONA_MODEL_TIMEOUT_SECONDS=
AEGISDESK_PERSONA_MODEL_TEMPERATURE=

# PostgreSQL connection string for durable checkpoints, approvals, and audit.
# Leave unset to use the in-memory implementations (tests and local runs).
AEGISDESK_DATABASE_URL=
